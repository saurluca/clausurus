UPSTREAM_BASE_URL=https://api.openai.com/v1
ALLOW_UPSTREAM_OVERRIDE=false
UPSTREAM_ALLOWLIST=

# Detector: any OpenAI-compatible chat model. Apertus is the default.
DETECTOR_BASE_URL=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
DETECTOR_MODEL=swiss-ai/Apertus-v1.5-70B
DETECTOR_API_KEY=

# llm+regex | regex
DETECTION=llm+regex
# block | regex
ON_DETECTOR_ERROR=block

PORT=8787
HOST=127.0.0.1
SESSION_TTL_SECONDS=3600
ALLOW_RAW_BODIES=false
# true prints the masked body instead of forwarding
INSPECT=false
