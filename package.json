{
  "name": "apertus-privacy-gateway",
  "version": "0.1.0",
  "description": "Local privacy proxy. Mask personal data before it reaches any model API, then restore it in the reply.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "apertus-privacy-gateway": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "bun src/cli.ts",
    "test": "bun test tests extension/tests",
    "bench": "bun scripts/bench-pii.ts",
    "build:ext": "bun extension/build.ts",
    "spike:ner": "bun scripts/spike-ner.ts",
    "test:ext": "bun test extension/tests && playwright test --config extension/playwright.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "happy-dom": "^20.14.5",
    "onnxruntime-node": "^1.30.0",
    "onnxruntime-web": "^1.30.0",
    "typescript": "^7.0.2"
  }
}
